# ---------------------------------------------------------------------------
# Database (PostgreSQL). Supabase, Neon and plain Postgres all work.
# ---------------------------------------------------------------------------
DATABASE_URL="postgres://user:password@localhost:5432/mykart"

# ---------------------------------------------------------------------------
# Canonical site URL. Used for Stripe success/cancel redirects, sitemap,
# robots.txt and Open Graph metadata.
#
# This MUST be set server-side: checkout redirect URLs were previously taken
# from the browser's window.location.origin, which a caller can forge.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sessions. Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET="replace-me-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Stripe
#
# STRIPE_WEBHOOK_SECRET comes from the endpoint you register at
#   <site>/api/webhooks/stripe
# for the `checkout.session.completed` event. Locally:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Supabase Storage (product imagery).
# NEXT_PUBLIC_SUPABASE_STORAGE_URL is the public object base URL; its hostname
# is what next/image is allowed to optimise.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_STORAGE_BUCKET="ecommerce"
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://your-project.supabase.co/storage/v1/object/public/ecommerce"

# ---------------------------------------------------------------------------
# First admin account. Read once by `npm run db:seed` to create the initial row
# in `admin_users`; not used at runtime afterwards. Rotate passwords in-app.
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
